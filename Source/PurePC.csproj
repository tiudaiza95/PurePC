<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PurePC</AssemblyName>
    <RootNamespace>PurePC</RootNamespace>
    <ApplicationIcon>..\PurePC.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="MainWindow.xaml">
      <LogicalName>PurePC.MainWindow.xaml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\PurePC.png">
      <LogicalName>PurePC.Icon.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
